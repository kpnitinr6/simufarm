FROM python:3.12-slim
WORKDIR /app
COPY packages/device-schema /app/packages/device-schema
COPY pyproject.toml /app/
COPY apps /app/apps
RUN pip install --no-cache-dir ./packages/device-schema .
COPY data /app/data
COPY scripts /app/scripts
RUN useradd --create-home simufarm
USER simufarm
EXPOSE 8000
CMD ["uvicorn", "simufarm_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
