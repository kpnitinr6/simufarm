{
  "$defs": {
    "Build": {
      "additionalProperties": false,
      "properties": {
        "ro.product.brand": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ro.Product.Brand"
        },
        "ro.product.model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ro.Product.Model"
        },
        "ro.product.device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ro.Product.Device"
        },
        "ro.build.fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ro.Build.Fingerprint"
        },
        "source_type": {
          "anyOf": [
            {
              "enum": [
                "manufacturer_spec",
                "lineageos_tree",
                "xda_dump",
                "firmware",
                "third_party_device_db",
                "firmware_dump"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Type"
        },
        "sources": {
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "ro.product.brand",
        "ro.product.model",
        "ro.product.device",
        "ro.build.fingerprint"
      ],
      "title": "Build",
      "type": "object"
    },
    "Notch": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "none",
            "punch_hole",
            "notch",
            "teardrop",
            "dynamic_island"
          ],
          "title": "Type",
          "type": "string"
        },
        "position": {
          "enum": [
            "none",
            "top_center",
            "top_left",
            "top_right"
          ],
          "title": "Position",
          "type": "string"
        }
      },
      "required": [
        "type",
        "position"
      ],
      "title": "Notch",
      "type": "object"
    },
    "Screen": {
      "additionalProperties": false,
      "properties": {
        "width_px": {
          "exclusiveMinimum": 0,
          "title": "Width Px",
          "type": "integer"
        },
        "height_px": {
          "exclusiveMinimum": 0,
          "title": "Height Px",
          "type": "integer"
        },
        "dpi": {
          "exclusiveMinimum": 0,
          "title": "Dpi",
          "type": "number"
        }
      },
      "required": [
        "width_px",
        "height_px",
        "dpi"
      ],
      "title": "Screen",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "brand": {
      "minLength": 1,
      "title": "Brand",
      "type": "string"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "release_year": {
      "maximum": 2100,
      "minimum": 1980,
      "title": "Release Year",
      "type": "integer"
    },
    "os_family": {
      "enum": [
        "android",
        "ios"
      ],
      "title": "Os Family",
      "type": "string"
    },
    "os_version": {
      "minLength": 1,
      "title": "Os Version",
      "type": "string"
    },
    "shell_id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Shell Id",
      "type": "string"
    },
    "base_image_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Base Image Id"
    },
    "screen": {
      "$ref": "#/$defs/Screen"
    },
    "notch": {
      "$ref": "#/$defs/Notch"
    },
    "ram_gb": {
      "exclusiveMinimum": 0,
      "title": "Ram Gb",
      "type": "number"
    },
    "build": {
      "anyOf": [
        {
          "$ref": "#/$defs/Build"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime_eligible": {
      "default": false,
      "title": "Runtime Eligible",
      "type": "boolean"
    },
    "source_type": {
      "enum": [
        "api",
        "scraper",
        "manual"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "sources": {
      "items": {
        "format": "uri",
        "maxLength": 2083,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "verified_by": {
      "anyOf": [
        {
          "enum": [
            "human",
            "gemini",
            "ollama"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Verified By"
    },
    "verified_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Verified At"
    }
  },
  "required": [
    "id",
    "brand",
    "model",
    "release_year",
    "os_family",
    "os_version",
    "shell_id",
    "base_image_id",
    "screen",
    "notch",
    "ram_gb",
    "build",
    "source_type",
    "sources",
    "confidence",
    "verified_by",
    "verified_at"
  ],
  "title": "DeviceProfile",
  "type": "object"
}
