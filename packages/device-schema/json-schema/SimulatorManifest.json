{
  "$defs": {
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "ram_mb": {
          "exclusiveMinimum": 0,
          "maximum": 32768,
          "title": "Ram Mb",
          "type": "integer"
        },
        "vcpu": {
          "exclusiveMinimum": 0,
          "maximum": 16,
          "title": "Vcpu",
          "type": "integer"
        }
      },
      "required": [
        "ram_mb",
        "vcpu"
      ],
      "title": "Limits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "simulator_id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Simulator Id",
      "type": "string"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "static",
        "interactive",
        "runtime"
      ],
      "title": "Kind",
      "type": "string"
    },
    "shell_id": {
      "minLength": 1,
      "title": "Shell Id",
      "type": "string"
    },
    "base_image_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Base Image Id"
    },
    "status": {
      "enum": [
        "ready",
        "building",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    }
  },
  "required": [
    "simulator_id",
    "profile_id",
    "kind",
    "shell_id",
    "base_image_id",
    "status",
    "limits"
  ],
  "title": "SimulatorManifest",
  "type": "object"
}
